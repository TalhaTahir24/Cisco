! ACLs - standard and extended
!
! --- Standard ACL (by source only, place near destination) ---
access-list 10 permit 172.168.11.0 0.0.0.255
access-list 10 deny any

! Apply to filter routing updates / NAT selection / VTY source
access-group 10 in

! --- Extended ACL (source + dest + protocol, place near source) ---
! Block Telnet (TCP/23) from the Engineering VLAN to the server subnet
ip access-list extended BLOCK-TELNET
 deny tcp 172.168.11.0 0.0.0.255 any eq 23
 permit ip any any

! Named standard ACL
ip access-list standard MANAGEMENT-HOSTS
 permit host 10.0.0.52
 deny any

! Apply on an interface
interface GigabitEthernet0/0
 ip access-group BLOCK-TELNET in

! Restrict management access to the VTY lines by source
line vty 0 4
 access-class MANAGEMENT-HOSTS in

! Verify
! show access-lists
! show ip access-lists
