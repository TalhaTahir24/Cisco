! Device hardening
!
! --- Passwords ---
enable secret MyEnableSecret        ! MD5-hashed, not readable in config
service password-encryption          ! encrypts all plaintext passwords in config

! --- Banner (legal notice) ---
banner motd ^C Authorized access only ^C

! --- Line security ---
line con 0
 password MyConsolePass
 login local
 logging synchronous
 exec-timeout 5 0
!
line vty 0 4
 login local
 transport input ssh
 exec-timeout 5 0

! --- Disable unneeded services ---
no ip http server
no ip http secure-server
no service udp-small-servers
no service tcp-small-servers

! --- Interface security (access port default) ---
interface GigabitEthernet0/1
 switchport mode access
 no cdp enable

! --- Global protections ---
ip source-route
no ip domain-lookup
ip tcp synwait-time 10

! Verify
! show running-config | include secret
! show ip http server status
