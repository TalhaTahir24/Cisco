! AAA - Authentication, Authorization, Accounting (TACACS+ example)
!
! --- TACACS+ server ---
tacacs server TACS1
 address ipv4 10.0.0.60
 key TacacsKey01
!
aaa new-model

! --- Authentication: login via TACACS+, fall back to local ---
aaa authentication login default group tacacs+ local

! --- Authorization: exec + command-level control ---
aaa authorization exec default group tacacs+ local
aaa authorization commands 15 default group tacacs+ local

! --- Accounting: log exec sessions and commands ---
aaa accounting exec default start-stop group tacacs+
aaa accounting commands 15 default start-stop group tacacs+

! --- Enable mode via TACACS+ ---
aaa authentication enable default group tacacs+ enable

! --- Local fallback user ---
username admin privilege 15 secret StrongPassword

! --- RADIUS alternative ---
! radius server RAD1
!  address ipv4 10.0.0.61
!  key RadiusKey01
! aaa authentication login default group radius local

! Verify
! show aaa servers
! show aaa sessions
