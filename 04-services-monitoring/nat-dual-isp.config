! NAT/PAT with dual-ISP failover + IP SLA tracking
!
! Two ISPs, PAT on both uplinks. IP SLA probes the ISP gateways and
! redirects the default route if the primary dies. Mirrors the
! dual-ISP + VIP design in network-designs.
!
ip sla 1
 icmp-echo 203.0.113.1 source-interface GigabitEthernet0/0
 frequency 5
!
ip sla 2
 icmp-echo 198.51.100.1 source-interface GigabitEthernet0/1
 frequency 5
!
ip sla schedule 1 life forever start-time now
ip sla schedule 2 life forever start-time now

! Track both uplinks
track 1 ip sla 1 reachability
!
track 2 ip sla 2 reachability

! Default routes - primary preferred, secondary as standby
ip route 0.0.0.0 0.0.0.0 203.0.113.1 track 1
ip route 0.0.0.0 0.0.0.0 198.51.100.1 track 2

! Inside ACL = everything internal that may go out
ip access-list standard INTERNAL
 permit 172.16.0.0 0.0.15.255

! PAT on both WAN interfaces
ip nat inside source list INTERNAL interface GigabitEthernet0/0 overload
ip nat inside source list INTERNAL interface GigabitEthernet0/1 overload

! Port forwarding into the DMZ (mail + web)
ip nat inside source static tcp 172.16.20.10 25 203.0.113.2 25
ip nat inside source static tcp 172.16.20.11 443 203.0.113.2 443

! Interface roles
interface GigabitEthernet0/0
 description ISP-A
 ip nat outside
!
interface GigabitEthernet0/1
 description ISP-B
 ip nat outside
!
interface GigabitEthernet0/1.10
 ip nat inside
!
interface GigabitEthernet0/1.20
 ip nat inside

! Verify
! show ip sla statistics
! show track
! show ip route 0.0.0.0
! show ip nat translations
