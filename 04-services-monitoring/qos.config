! QoS - classify, mark, queue: protect real-time traffic under load
!
! Mark once at the edge, trust and queue downstream. Voice/video get
! LLQ (never starved), normal traffic shares, bulk gets lowest priority.
!
! Mark at the trusted edge (phone/voice VLANs)
class-map match-all VOICE
 match ip dscp ef
class-map match-all VIDEO
 match ip dscp af41
class-map match-any MANAGEMENT
 match ip dscp cs2
 match ip dscp cs6

policy-map MARK-EDGE
 class VOICE
  set ip dscp ef
 class VIDEO
  set ip dscp af41
 class MANAGEMENT
  set ip dscp cs2

! Queueing policy on the WAN uplink (must be the bottleneck link)
policy-map QOS-WAN
 class VOICE
  priority percent 20       ! LLQ - always served first
 class VIDEO
  bandwidth remaining percent 30
 class MANAGEMENT
  bandwidth remaining percent 5
 class class-default
  fair-queue
  random-detect dscp-based   ! WRED for TCP drops before tail drop

! Attach: trust on the LAN access ports, apply queueing outbound on WAN
interface GigabitEthernet0/0
 description WAN-Uplink
 service-policy output QOS-WAN
!
interface GigabitEthernet0/1.10
 description LAN-Edge
 service-policy input MARK-EDGE

! Verify
! show policy-map interface
! show class-map
! show queueing interface
