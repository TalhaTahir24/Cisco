! NetFlow - flow monitoring for visibility and capacity planning
!
! Version 9 flexible export to the collector. Use this instead of
! counting on interface counters alone: who talks to whom, protocol,
! volume - per flow.
!
ip flow-export version 9
ip flow-export destination 10.10.0.50 9996
ip flow-export source GigabitEthernet0/0
ip flow-export template refresh-rate 20
ip flow-export template timeout-rate 30

! Sample every Nth packet on high-throughput interfaces (e.g. 1 in 100)
sampler FLOW-SAMPLE
 mode random 1 out-of 100

! Enable flow on WAN-facing and LAN-facing interfaces
interface GigabitEthernet0/0
 description WAN
 ip flow ingress
 ip flow egress
!
interface GigabitEthernet0/1.10
 description LAN
 ip flow ingress
 ip flow egress

! Optional: NetFlow top-talkers locally
ip flow-top-talkers
 top 20
 sort-by bytes
 cache-timeout 60

! Verify
! show ip flow export
! show ip cache flow
! show ip flow-top-talkers
