! NAT / PAT
!
! --- Static NAT (web server 1:1) ---
ip nat inside source static 172.168.11.10 203.0.113.10

! --- Dynamic NAT pool ---
ip nat pool NAT-POOL 203.0.113.20 203.0.113.30 netmask 255.255.255.240
access-list 10 permit 172.168.11.0 0.0.0.255
ip nat inside source list 10 pool NAT-POOL

! --- PAT (overload) - one outside address for all internal hosts ---
ip nat pool PAT-POOL 203.0.113.40 203.0.113.40 netmask 255.255.255.240
ip nat inside source list 10 pool PAT-POOL overload
! or overload the interface address directly:
ip nat inside source list 10 interface GigabitEthernet0/0 overload

! --- Port forwarding (static NAT for a service) ---
ip nat inside source static tcp 172.168.11.10 443 203.0.113.10 443

! --- Interface roles ---
interface GigabitEthernet0/0
 ip nat outside
!
interface Vlan10
 ip nat inside
!
interface Vlan20
 ip nat inside

! Verify
! show ip nat translations
! show ip nat statistics
! debug ip nat
