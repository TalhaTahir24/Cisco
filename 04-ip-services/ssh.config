! SSH - secure remote management
!
! 1. Hostname + domain required for crypto key generation
hostname R1
ip domain-name corp.local

! 2. RSA key (minimum 2048)
crypto key generate rsa modulus 2048

! 3. Username + encrypted password
username admin secret StrongPassword

! 4. VTY lines -> SSH only
line vty 0 4
 login local
 transport input ssh
 exec-timeout 10 0

! 5. Enable SSH v2, restrict timeout/auth
ip ssh version 2
ip ssh authentication-retries 3
ip ssh time-out 60

! Verify
! show ip ssh
! show ssh
! ssh -l admin 192.168.10.1
