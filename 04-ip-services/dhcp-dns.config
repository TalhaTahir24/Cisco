! DHCP + DNS
!
! --- DHCP server on the router ---
ip dhcp excluded-address 172.168.11.1 172.168.11.50
!
ip dhcp pool LAN-VLAN10
 network 172.168.11.0 255.255.255.0
 default-router 172.168.11.1
 dns-server 8.8.8.8 172.168.11.53
 domain-name corp.local
 lease 1 0 0

! Static DHCP binding for a server (by MAC)
ip dhcp pool SRV-APPSRV
 host 172.168.11.10 255.255.255.0
 client-identifier 0100.5067.9a01.10

! DHCP relay to a central server (client subnet is remote)
interface Vlan30
 ip helper-address 10.0.0.53

! --- DNS ---
! Router as forwarder
ip name-server 8.8.8.8
! Router resolves names for local devices
ip host appsrv 172.168.11.10

! Verify
! show ip dhcp binding
! show ip dhcp pool
! debug ip dhcp server events
