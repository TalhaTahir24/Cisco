! VRF-lite - separate routing tables for isolated tenants/environments
!
! Multiple logical routers on one box. Used to keep customer/dev/prod
! traffic in isolated tables without adding physical devices.
!
! Two VRFs: CUST-A and CUST-B, each with own table + interfaces
vrf definition CUST-A
 rd 65001:100
 route-target export 65001:100
 route-target import 65001:100
!
vrf definition CUST-B
 rd 65001:200
 route-target export 65001:200
 route-target import 65001:200

! Same address space in both VRFs - no collision because tables differ
interface GigabitEthernet0/0.10
 encapsulation dot1Q 10
 vrf forwarding CUST-A
 ip address 10.1.1.1 255.255.255.0
!
interface GigabitEthernet0/0.20
 encapsulation dot1Q 20
 vrf forwarding CUST-B
 ip address 10.1.1.1 255.255.255.0

! Per-VRF default routes (both can use 10.1.1.1 locally, same subnet)
ip route vrf CUST-A 0.0.0.0 0.0.0.0 10.0.0.254
ip route vrf CUST-B 0.0.0.0 0.0.0.0 10.0.0.254

! Verify
! show ip vrf
! show ip vrf detail
! show ip route vrf CUST-A
! vrf definition CUST-A + ping vrf CUST-A 10.1.1.10
