! Route redistribution - controlled injection between routing domains
!
! Scenario: edge router carries eBGP (ISP routes), OSPF (internal),
! and EIGRP (legacy site). Redistribution must be filtered by route-map,
! never unconditional, or you leak the full internet table internally.
!
router ospf 1
 ! Advertise the default from the ISP edge into OSPF only
 default-information originate always
 ! Redistribute EIGRP internal routes into OSPF, tagged + filtered
 redistribute eigrp 10 subnets route-map EIGRP-TO-OSPF
 tag 65001

router eigrp 10
 network 10.40.0.0
 no auto-summary
 ! Redistribute a limited OSPF subset back (avoid routing loops)
 redistribute ospf 1 metric 10000 100 255 1 1500 route-map OSPF-TO-EIGRP

! Mutual redistribution requires tags + filters to stop loops.
! Routes we originated get tagged 65001 and are never re-advertised.
access-list 10 permit 10.40.0.0 0.0.0.255
access-list 20 permit 172.16.10.0 0.0.255.255

route-map EIGRP-TO-OSPF permit 10
 match ip address 10
 set metric 100
 set tag 100
 set metric-type type-1

route-map OSPF-TO-EIGRP deny 10
 match tag 65001
!
route-map OSPF-TO-EIGRP permit 20
 match ip address 20
 set metric 10000

! Verify
! show ip protocols
! show ip route redistribute
! show route-map
