! BGP - dual-homed to two ISPs with inbound/outbound path control
!
! Two uplinks to different providers. eBGP learns both full tables.
! local-preference controls outbound choice; AS-path prepend + MED
! control how much inbound traffic each path attracts.
!
router bgp 65001
 bgp router-id 1.1.1.1
 bgp log-neighbor-changes
 bgp bestpath as-path ignore          ! (optional) peer AS only

 ! Two eBGP sessions, one per ISP
 neighbor 203.0.113.1 remote-as 64500  ! ISP-A
 neighbor 203.0.113.1 description ISP-A-Primary
 neighbor 198.51.100.1 remote-as 64501 ! ISP-B
 neighbor 198.51.100.1 description ISP-B-Backup

 ! Outbound: prefer ISP-A unless it dies (default local-pref 100)
 neighbor 203.0.113.1 route-map ISP-A-OUT out
 neighbor 203.0.113.1 route-map ISP-A-IN in

 ! Advertise our prefix, and nothing else
 network 172.16.0.0 mask 255.255.0.0
 neighbor 203.0.113.1 prefix-list OUR-PREFIX out
 neighbor 198.51.100.1 prefix-list OUR-PREFIX out

! --- Outbound policy ---
! Normal outbound for ISP-A; prepend our AS 3x on ISP-B so inbound
! traffic prefers ISP-A.
route-map ISP-A-OUT permit 10
 match ip address prefix-list OUR-PREFIX
 set local-preference 200
!
route-map ISP-B-OUT permit 10
 match ip address prefix-list OUR-PREFIX
 set as-path prepend 65001 65001 65001

! --- Inbound policy ---
! Tag routes by source ISP, then lower ISP-B's local-pref so return
! traffic leaves via ISP-A when both are up.
ip prefix-list OUR-PREFIX seq 5 permit 172.16.0.0/16

route-map ISP-A-IN permit 10
 set local-preference 200
!
route-map ISP-B-IN permit 10
 set local-preference 50

! Filter out martians/bogons inbound from both ISPs (best practice)
neighbor 203.0.113.1 prefix-list BOGONS in
neighbor 198.51.100.1 prefix-list BOGONS in

ip prefix-list BOGONS deny 0.0.0.0/0 le 32
ip prefix-list BOGONS deny 10.0.0.0/8 le 32
ip prefix-list BOGONS deny 100.64.0.0/10 le 32
ip prefix-list BOGONS deny 172.16.0.0/12 le 32
ip prefix-list BOGONS deny 192.168.0.0/16 le 32
ip prefix-list BOGONS deny 224.0.0.0/4 le 32
ip prefix-list BOGONS permit 0.0.0.0/0 le 32

! eBGP peer authentication
neighbor 203.0.113.1 password ISP_A_Key01
neighbor 198.51.100.1 password ISP_B_Key01

! Verify
! show ip bgp summary
! show ip bgp
! show ip bgp neighbors 203.0.113.1 advertised-routes
