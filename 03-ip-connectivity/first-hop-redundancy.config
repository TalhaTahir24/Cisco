! First Hop Redundancy - HSRP (Cisco), VRRP (open), GLBP (Cisco)
!
! --- HSRP (active/standby) ---
interface Vlan10
 ip address 172.168.11.2 255.255.255.0
 standby version 2
 standby 10 ip 172.168.11.1        ! virtual IP used by end hosts
 standby 10 priority 120           ! higher priority = active (default 100)
 standby 10 preempt                 ! retake active role after recovery
 standby 10 track GigabitEthernet0/0 20   ! decrement priority if uplink fails

! --- VRRP (master/backup, open standard) ---
interface Vlan20
 ip address 172.168.12.2 255.255.255.0
 vrrp 20 ip 172.168.12.1
 vrrp 20 priority 120

! --- GLBP (single virtual IP, multiple forwarders) ---
interface Vlan30
 ip address 172.168.13.2 255.255.255.0
 glbp 30 ip 172.168.13.1
 glbp 30 load-balancing round-robin

! Verify
! show standby brief
! show vrrp brief
! show glbp brief
