! OSPF - single area (area 0)
!
router ospf 1
 router-id 1.1.1.1
 network 192.168.10.0 0.0.0.255 area 0
 network 172.168.10.0 0.0.0.255 area 0
 network 192.168.20.0 0.0.0.255 area 0
 passive-interface GigabitEthernet0/2

! Advertise the default route into OSPF (high metric = not preferred path)
default-information originate metric 100

! Loopback for management + OSPF stability (and router-id backup)
interface Loopback0
 ip address 1.1.1.1 255.255.255.255

! Interface cost overrides auto-derived cost (10^8 / bandwidth)
interface GigabitEthernet0/0
 ip ospf cost 10

! Verify
! show ip ospf neighbor
! show ip ospf interface
! show ip route ospf
! show ip ospf database
