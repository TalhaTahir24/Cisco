! HSRP/VRRP - redundant default gateway with uplink tracking
!
! Two edge routers share a virtual gateway. Interface tracking lets the
! active router step down when its uplink dies, so the standby takes over
! instead of black-holing traffic.
!
interface GigabitEthernet0/0
 description LAN-side virtual gateway
 ip address 172.16.1.2 255.255.255.0
 ! VRRP (open standard) - group 1, virtual IP is the default gw
 vrrp 1 address-family ipv4
  vrrp 1 ip 172.16.1.1
  vrrp 1 priority 110
  vrrp 1 preempt
  vrrp 1 timers advertise 1
  ! Drop priority below standby (100) when the ISP uplink goes down
  vrrp 1 track interface GigabitEthernet0/1 decrement 20
  vrrp 1 authentication md5 key-string VrrpKey01

! HSRP alternative (Cisco) - same idea
! interface GigabitEthernet0/0
!  standby 1 ip 172.16.1.1
!  standby 1 priority 110
!  standby 1 preempt
!  standby 1 track GigabitEthernet0/1 20

! WAN uplink being tracked
interface GigabitEthernet0/1
 description ISP uplink
 ip address 203.0.113.2 255.255.255.252

! Verify
! show vrrp brief
! show vrrp
! show standby
