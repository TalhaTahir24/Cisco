! EtherChannel - LACP bundle for uplink bandwidth + resiliency
!
! Two 10G links to the core become one logical link: more throughput,
! no STP blocking, single link failure tolerated without reconvergence.
!
interface Port-channel1
 description To-CORE
 switchport trunk encapsulation dot1q
 switchport mode trunk
 switchport trunk allowed vlan 10,20,30,100
 ! Load balance method must match on both ends
 channel-group 1 mode active
 spanning-tree portfast trunk

! Member interfaces - identical speed/duplex/VLAN settings or LACP rejects
interface GigabitEthernet1/0/1
 description To-CORE-LAG-Member
 switchport trunk encapsulation dot1q
 switchport mode trunk
 channel-group 1 mode active
!
interface GigabitEthernet1/0/2
 description To-CORE-LAG-Member
 switchport trunk encapsulation dot1q
 switchport mode trunk
 channel-group 1 mode active

! Optional: layer-3 EtherChannel (routed LAG to core/distribution)
! interface Port-channel10
!  no switchport
!  ip address 10.0.1.1 255.255.255.0

! Verify
! show etherchannel summary
! show etherchannel port-channel
! show interfaces port-channel 1
! show lacp counters
