! Control-plane policing (CoPP) - protect the router CPU
!
! Routers drop when the control plane is flooded. CoPP rate-limits
! traffic destined to the CPU (BGP, OSPF, SSH, SNMP) so protocol
! sessions survive DDoS even if the data plane is under attack.
!
! Classify control-plane traffic
class-map match-all COPP-MGMT
 match ip dscp cs2
!
class-map match-all COPP-OSPF
 match protocol ospf
!
class-map match-all COPP-BGP
 match protocol bgp
!
class-map match-any COPP-SSH-SNMP
 match protocol ssh
 match protocol snmp

! Policy: permit protocol traffic at generous but capped rates
policy-map COPP-POLICY
 class COPP-MGMT
  police cir 64000 bc 1500
   conform-action transmit
   exceed-action drop
 class COPP-OSPF
  police cir 8000 bc 1500
   conform-action transmit
   exceed-action drop
 class COPP-BGP
  police cir 32000 bc 1500
   conform-action transmit
   exceed-action drop
 class COPP-SSH-SNMP
  police cir 16000 bc 1500
   conform-action transmit
   exceed-action drop
 class class-default
  police cir 8000 bc 1500
   conform-action transmit
   exceed-action drop

! Attach to the control plane
control-plane
 service-policy input COPP-POLICY

! Verify
! show policy-map control-plane
! show control-plane host open-ports
