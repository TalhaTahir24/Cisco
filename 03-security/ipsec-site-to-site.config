! IPsec site-to-site VPN - IKEv2, AES-GCM, DH group 14
!
! Production site-to-site between HQ and a branch. IKEv2 for key
! exchange, IPsec tunnel mode, dead peer detection for fast failover.
!
crypto ikev2 proposal IKE-PROP
 encryption aes-gcm-256
 integrity prf-sha256
 group 14
!
crypto ikev2 policy IKE-POL
 proposal IKE-PROP
!
crypto ikev2 keyring IKE-KEY
 peer BRANCH
  address 198.51.100.10
  pre-shared-key local PreSharedKey01
  pre-shared-key remote PreSharedKey01
!
crypto ikev2 profile IKE-PROF
 match identity remote address 198.51.100.10 255.255.255.255
 identity local address 203.0.113.2
 authentication remote pre-share
 authentication local pre-share
 keyring local IKE-KEY
 lifetime 86400
 dpd 10 3 periodic

! IPsec transform set - modern suite, no weak ciphers
crypto ipsec transform-set TS-AES256 esp-aes 256 esp-sha-hmac
 mode tunnel
!
crypto ipsec profile IPSEC-PROF
 set transform-set TS-AES256
 set ikev2-profile IKE-PROF

! Tunnel interface for the overlay network
interface Tunnel0
 description VPN-to-BRANCH
 ip address 172.16.100.1 255.255.255.252
 tunnel source GigabitEthernet0/1
 tunnel destination 198.51.100.10
 tunnel mode ipsec ipv4
 tunnel protection ipsec profile IPSEC-PROF

! Interesting traffic = traffic crossing the tunnel to the remote LAN
ip route 172.16.200.0 255.255.255.0 Tunnel0

! Verify
! show crypto ikev2 sa
! show crypto ipsec sa
! show interface tunnel 0
