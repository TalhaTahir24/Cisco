! AAA - central authentication, authorization, and accounting
!
! TACACS+ separates auth (who), authorization (which commands),
! accounting (what they ran). Local fallback keeps console access
! alive if the AAA server is unreachable.
!
aaa new-model

! Server config
tacacs server TACACS1
 address ipv4 10.10.0.5
 key TacacsKey01
 timeout 5
!
radius server RADIUS1
 address ipv4 10.10.0.6
 key RadiusKey01

! Order: try TACACS+, fall back to local users
aaa authentication login default group tacacs+ local
aaa authentication enable default group tacacs+ enable

! Authorization for exec (shell) + commands at each privilege level
aaa authorization exec default group tacacs+ local
aaa authorization commands 1 default group tacacs+ local
aaa authorization commands 15 default group tacacs+ local

! Accounting for user exec + privileged commands
aaa accounting exec default start-stop group tacacs+
aaa accounting commands 15 default start-stop group tacacs+

! Local user as offline fallback
username admin privilege 15 secret AdminPass01

! Apply to lines
line console 0
 login authentication default
!
line vty 0 4
 login authentication default
 transport input ssh

! Verify
! show aaa servers
! show aaa user
! debug aaa authentication
