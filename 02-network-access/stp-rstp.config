! STP / RSTP
!
! --- STP (802.1D) ---
spanning-tree mode pvst
! This switch should be root for VLAN 10 (lowest priority wins)
spanning-tree vlan 10 priority 4096

! --- RSTP (802.1w) per-VLAN (RPVST+) ---
spanning-tree mode rapid-pvst

! Ports facing end devices = edge ports (immediate forwarding, no BPDUs)
interface GigabitEthernet0/1
 spanning-tree portfast edge

! Also protected against BPDUs arriving on access ports
 spanning-tree bpduguard enable

! Verify
! show spanning-tree
! show spanning-tree vlan 10
! show spanning-tree root
