! DTP - Dynamic Trunking Protocol
!
! DTP negotiates whether a link becomes a trunk.
!
interface GigabitEthernet0/24
 switchport mode dynamic desirable   ! actively negotiates to trunk
! switchport mode dynamic auto        ! waits for the peer to ask
! switchport mode trunk               ! static trunk, no negotiation
! switchport nonegotiate              ! stop sending DTP frames entirely

! Verify
! show interfaces GigabitEthernet0/24 switchport | include Negotiation
